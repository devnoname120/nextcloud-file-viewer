{
  "name": "nextcloud-file-viewer",
  "description": "Universal File Viewer for Nextcloud, powered by Flyfish File Viewer",
  "version": "0.5.6",
  "author": "devnoname120",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "audit:production": "npm audit --omit=dev --audit-level=low",
    "test:browser:iframe": "playwright test tests/e2e/iframe-smoke.spec.mjs --browser=chromium",
    "test:browser:examples": "playwright test tests/e2e/upstream-examples.spec.mjs --browser=chromium",
    "test:e2e:nextcloud": "playwright test tests/e2e/nextcloud-smoke.spec.mjs --browser=chromium",
    "test:e2e:nextcloud:samples": "playwright test tests/e2e/nextcloud-samples.spec.mjs --browser=chromium",
    "generate:formats": "node scripts/generate-supported-formats.mjs",
    "copy:admin-styles": "node scripts/copy-admin-styles.mjs",
    "copy:viewer-assets": "node scripts/copy-viewer-assets.mjs",
    "build:specialists": "vite build --config vite.specialist.config.js --mode production",
    "verify:dependencies": "node scripts/verify-dependencies.mjs",
    "verify:copied-assets": "node scripts/verify-dependencies.mjs --copied",
    "build": "npm run generate:formats && vite --mode production build && npm run copy:admin-styles && npm run copy:viewer-assets && npm run build:specialists && npm run verify:copied-assets",
    "dev": "npm run generate:formats && vite --mode development build && npm run copy:admin-styles && npm run copy:viewer-assets && vite build --config vite.specialist.config.js --mode development",
    "watch": "npm run generate:formats && vite --mode development build --watch"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.16.0"
  },
  "dependencies": {
    "@file-viewer/capability-rtf": "^3.1.2",
    "@file-viewer/core": "^3.1.2",
    "@file-viewer/renderer-binary": "^3.1.2",
    "@file-viewer/renderer-chm": "^3.1.2",
    "@file-viewer/renderer-design": "^3.1.2",
    "@file-viewer/renderer-dicom": "^3.1.2",
    "@file-viewer/renderer-signature": "^3.1.2",
    "@file-viewer/web-full": "^3.1.2",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "^9.13.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@playwright/test": "^1.63.0",
    "mime-types": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "allowScripts": {
    "@file-viewer/web": false,
    "core-js": false,
    "core-js-pure": false,
    "es5-ext": false,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "adm-zip": "0.6.1",
    "dompurify": "^3.4.16",
    "fflate": "0.7.5",
    "katex": "^0.18.10",
    "minimatch": "^10.2.6",
    "uuid": "11.1.1"
  }
}
